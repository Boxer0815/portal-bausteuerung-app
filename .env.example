# Bausteuerung-App — Konfigurationsvorlage
# Kopiere diese Datei nach .env und passe die Werte für deine Umgebung an.
# Die .env-Datei darf NICHT eingecheckt werden (siehe .gitignore).

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=portal
KEYCLOAK_CLIENT_ID=bausteuerung-app

# Backend-API
BACKEND_URL=http://localhost:3001

# Erlaubte Rollen (kommasepariert)
ERLAUBTE_ROLLEN=monteur,dienstleister
